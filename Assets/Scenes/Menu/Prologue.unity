  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c0a136a16f049ad837a4472a125bec9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PrologueController
  gameSceneName: gamebackup
  messages:
  - fromPlayer: 0
    text: 'yo, you still going to that island you were talking about? '
  - fromPlayer: 1
    text: 'yea, kinda wanna just take a break from trading bonds... '
  - fromPlayer: 1
    text: its so boring here, and thats the place where i grew up
  - fromPlayer: 0
    text: you meeting your mom there?
  - fromPlayer: 1
    text: yep, i'm staying there with her for like 4 days
  - fromPlayer: 1
    text: i'll be back in the office in no time
  - fromPlayer: 0
    text: alright sounds good!
  - fromPlayer: 0
    text: what about that truck of yours? you want me to look after it or something?
  - fromPlayer: 1
    text: nah, i'm taking it with me
  - fromPlayer: 0
    text: what??
  - fromPlayer: 0
    text: how??
  - fromPlayer: 1
    text: using the car ferry?
  - fromPlayer: 1
    text: duh
  - fromPlayer: 0
