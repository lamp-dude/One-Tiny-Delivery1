  creditImages:
  - {fileID: 2800000, guid: 1d12dadec67284797b05a4fbdb4d441b, type: 3}
  - {fileID: 2800000, guid: 7d472469abeae4edd9f8feee77255713, type: 3}
  - {fileID: 2800000, guid: 76132b9c3cfcd4c6fb32529916a3013f, type: 3}
  - {fileID: 2800000, guid: 477848abb1d4e404181a9f1c0d15e444, type: 3}
  logoImage: {fileID: 2800000, guid: 8bb9279c2ae164654b6961d5655b1b0e, type: 3}
  cardSeconds: 9
  fadeSeconds: 3
  returnFadeSeconds: 3
  creditImageFrameSize: {x: 500, y: 220}
  epilogueLines:
  - fromPlayer: 0
    text: hey dude, it's been 5 days
  - fromPlayer: 0
    text: where you at?
  - fromPlayer: 1
    text: im still on the island
  - fromPlayer: 0
    text: you said you were gonna be back yesterday?
  - fromPlayer: 1
    text: uhh
  - fromPlayer: 1
    text: i'm gonna stay a while
  - fromPlayer: 0
    text: WHAT?
  - fromPlayer: 0
    text: you told Rogers you'd be back already though?!
  - fromPlayer: 0
    text: and now he's been trying to get ahold of you!
  - fromPlayer: 1
    text: just let him be
  - fromPlayer: 0
    text: HUH??!!
  - fromPlayer: 0
    text: are you HEARING yourself right now?
  - fromPlayer: 0
    text: do you WANT to get laid off?
  - fromPlayer: 1
    text: 'you know what '
  - fromPlayer: 1
    text: i never lived having that job
  - fromPlayer: 1
    text: trying to trade bonds everyday
  - fromPlayer: 1
    text: having management following me around ever
  - fromPlayer: 1
    text: its the most boring job ever
  - fromPlayer: 1
    text: and i've already made my good share of money
  - fromPlayer: 1
    text: so yes
  - fromPlayer: 1
    text: tell Rogers i quit
  - fromPlayer: 0
    text: ???!!!
  - fromPlayer: 0
    text: CALL ME RIGHT NOW
  epilogueCharactersPerSecond: 38
  epiloguePauseAfterLine: 2.5
  dialogueFont: {fileID: 0}
