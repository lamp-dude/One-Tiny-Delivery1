  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1b24577c1dd764b1b83c0b6b6a89812b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DeliverySystem
  deliveries:
  - id: main
    objectiveName: main objective
    giverVoice: 1
    cargoPrefab: {fileID: 2031168280820652090, guid: 2b200feb346ba403dae1231547282463, type: 3}
    safeCargoAnchor: {fileID: 1207837740943526512}
    cargoSpawnHeight: 1
    droppedDistance: 5
    destroyCargoOnDelivery: 1
    pickupConversation:
    - speaker: 0
      text: hey Bubo, it's been a while since I've seen you
    - speaker: 1
      text: hi mom
    - speaker: 0
      text: 'everything alright back at the city? '
    - speaker: 1
      text: i'm fine, everything is fine
    - speaker: 1
      text: 'i just feel... '
    - speaker: 1
      text: like i needed some fresh air
    - speaker: 0
      text: 'haha what? '
    - speaker: 0
      text: the city was too much for you?
    - speaker: 0
      text: 2 months ago when i was there visting you
    - speaker: 0
      text: you seemed very happy with your life!
    - speaker: 1
      text: uh... yea, i still feel like i need a break
    - speaker: 0
      text: well since you brought your little truck thing along
    - speaker: 0
      text: could you do me a favor first?
    - speaker: 1
      text: huh? with WHAT?!
    - speaker: 1
      text: didn't i JUST say i needed a break?
    - speaker: 0
      text: 'i just want fresh apples and apple juice delivered  '
    - speaker: 1
      text: 'don''t tell me it''s up on the mountain '
    - speaker: 0
      text: what? no ur silly
    - speaker: 0
      text: its our neighbors, the Johnstons
    - speaker: 1
      text: i forgot where that is...
    - speaker: 0
      text: just make a left at the fork
    - speaker: 1
      text: 'ok fine. '
    - speaker: 0
      text: oh and, if you drop something
    - speaker: 0
      text: you can always just keep driving to your detination
    - speaker: 0
      text: or you can press "R" to restart!
    - speaker: 1
      text: uhhh yea mom
    - speaker: 1
      text: i'll keep that in mind...
    startedConversation:
    - speaker: 0
      text: thats it! you know, I'm glad to have you back!
    - speaker: 1
      text: I'll get it there safely...
    startedReturnConversation:
    - speaker: 0
      text: well... you still delivering it?
    - speaker: 1
      text: yea yea, I'm still on it
    - speaker: 1
      text: i don't know why i came back
    finishedConversation:
    - speaker: 0
      text: thanks!
    - speaker: 1
      text: you know me
    - speaker: 1
      text: always...
    - speaker: 1
      text: happy...
    - speaker: 1
      text: to help.
    - speaker: 1
      text: hm.
    acceptAfterNotStartedDialogue: 1
    arrivalConversation:
    - speaker: 0
      text: oh hey!
    - speaker: 0
      text: is that you Bubo?
    - speaker: 1
      text: yep, its me again
    - speaker: 0
      text: i haven't see you in like
    - speaker: 0
      text: forever!
    - speaker: 0
      text: i'm very glad to see you again
    - speaker: 0
      text: how is your mother?
    - speaker: 1
      text: 'she''s fine '
    deliveredConversation:
    - speaker: 1
      text: she wanted me to deliver these apples to you
    - speaker: 1
      text: oh, yes and the juice
    - speaker: 0
      text: 'YES! THANK YOU! '
    - speaker: 0
      text: i love your mother's apples
    - speaker: 0
      text: they are the best ones on the island
    - speaker: 1
      text: huh? is there other apple trees on the island?
    - speaker: 0
      text: 'things haven''t changed since you left Bubo '
    - speaker: 0
      text: so no
    - speaker: 1
      text: well...
    - speaker: 0
      text: 'ANYWAY, thanks again! '
    - speaker: 1
      text: no problem! anytime Mrs. Johnston!
    - speaker: 0
      text: wait, anytime?
    - speaker: 0
      text: plase don't be annoyed but
    droppedCargoConversation:
    - speaker: 0
      text: thats good to hear!
    - speaker: 0
      text: what made you come over?
    - speaker: 1
      text: 'well... '
    - speaker: 1
      text: i was supposed to delivery some apples and juice but...
    - speaker: 1
      text: it seems i have dropped some of them...
    - speaker: 1
      text: sorry...
    - speaker: 0
      text: that's ok
    - speaker: 0
      text: you still have some left over
    - speaker: 1
      text: sorry again...
    - speaker: 0
      text: it's quite alright
    - speaker: 0
      text: we all make mistakes
    - speaker: 0
      text: though since you came here anyway...
    nextDeliveryConversation:
    - speaker: 0
      text: would you be so kind to...
    - speaker: 1
      text: to...?
    - speaker: 0
      text: to deliver a statue?
    - speaker: 0
      text: to deliver this statue?
    - speaker: 1
      text: STATUE?!
    - speaker: 1
      text: a STATUE...?
    - speaker: 0
      text: yes Bubo, it's not that big
    - speaker: 0
      text: it's Mr. Lawrence's cat statue
    - speaker: 0
      text: his cat died just a month ago
    - speaker: 0
      text: 'he wanted me to make him a statue for its grave '
    - speaker: 0
      text: 'poor thing...  '
    - speaker: 0
      text: that cat was the only one living with him
    - speaker: 0
      text: you do know where he lives right?
    - speaker: 1
      text: yea, i remember, beside that lake?
    - speaker: 0
      text: yes dear, beside that lake
    - speaker: 0
      text: i hope you take on this delivery then?
    - speaker: 1
      text: i guess so Mrs. Johnston
    - speaker: 0
      text: sorry, you just came at the right time
    - speaker: 0
      text: my husband is still working on his truck
    - speaker: 0
      text: 'it broke down a few days ago '
    - speaker: 1
      text: it's ok i'll deliver it
    - speaker: 1
      text: yea bye...
    completionDestination: {fileID: 0}
    completionTeleportDelay: 0.75
    completionGroundClearance: 0.35
    completionConversation: []
    completionSceneName: Finale
    completionSceneRevealSeconds: 0.85
