  - id: T-H
    objectiveName: one apple for the summit
    giverVoice: 7
    cargoPrefab: {fileID: 1846160755511594, guid: 8628e5710b6242d4b7849bfde9561ad1, type: 3}
    safeCargoAnchor: {fileID: 1207837740943526512}
    cargoSpawnHeight: 0
    droppedDistance: 3
    destroyCargoOnDelivery: 1
    pickupConversation: []
    startedConversation: []
    startedReturnConversation:
    - speaker: 0
      text: follow the road up to the house
    - speaker: 1
      text: it is quite steep
    - speaker: 0
      text: well there are no other paths.
    finishedConversation:
    - speaker: 0
      text: good to see you made it
    - speaker: 1
      text: it's a nice place to stop
    - speaker: 1
      text: i wanted to say...
    - speaker: 1
      text: thank you.
    - speaker: 0
      text: thank you for the delivery opportunity.
    acceptAfterNotStartedDialogue: 1
    arrivalConversation:
    - speaker: 0
      text: 'hello there! '
    - speaker: 0
      text: you came all the way up?
    - speaker: 0
      text: in THIS?!
    - speaker: 1
      text: 'yea... '
    - speaker: 1
      text: the priest at the temple sent me
    deliveredConversation:
    - speaker: 1
      text: he asked me to bring you this apple....
    - speaker: 0
      text: 'ah, my sunset apple. '
    - speaker: 0
      text: thank you!
    - speaker: 1
      text: you wanna know something funny?
    - speaker: 1
      text: i just realized...
    - speaker: 1
      text: i started down there delivering a whole load of apples.
    - speaker: 1
      text: now i'm on top of a mountain with one
    - speaker: 1
      text: funny where a little errand can take you...
    - speaker: 0
      text: i guess that's just how things are
    - speaker: 0
      text: everything happens becuase of everything
    - speaker: 0
      text: that's life
    - speaker: 1
      text: you're right
    - speaker: 1
      text: i didn't even want to deliver those apples in the first place...
    - speaker: 1
      text: well...
    - speaker: 1
      text: i'm glad i did
    - speaker: 1
      text: i've met so many people
    - speaker: 1
      text: heard so many stories
    - speaker: 1
      text: this is life
    - speaker: 1
      text: ...
    - speaker: 0
      text: ...
    - speaker: 1
      text: the view here is pretty...
    - speaker: 0
      text: 'you think here is pretty? '
    - speaker: 0
      text: i'll show you what actually is pretty
    - speaker: 0
      text: i'll get you some dinner then
    - speaker: 0
      text: i'll push your truck up this hill there
    - speaker: 0
      text: it has a beautiful view...
    - speaker: 0
      text: we can watch the sunset together!
    - speaker: 1
      text: ok!
    droppedCargoConversation:
    - speaker: 1
      text: nope. you did NOT see this.
    nextDeliveryConversation: []
    completionDestination: {fileID: 1915282911}
    completionTeleportDelay: 0.75
    completionGroundClearance: 0
    completionConversation:
    - speaker: 1
      text: woah...
    - speaker: 1
      text: its...
    - speaker: 1
      text: its beautiful.
    - speaker: 0
      text: i know right?
    - speaker: 0
      text: i come up here every day
    - speaker: 0
      text: and watch the orange glow set over this island
    - speaker: 0
      text: it's beautiful every time
    - speaker: 0
      text: even though i've seen it...
    - speaker: 0
      text: ...lets see...
    - speaker: 0
      text: i've seen it for 9232 days!
    - speaker: 0
      text: that's like 25 years of living here
    - speaker: 1
      text: you must really like this place huh?
    - speaker: 0
      text: well
    - speaker: 0
      text: even when times are rough
    - speaker: 0
      text: it is always beautiful
    - speaker: 0
      text: and...
    - speaker: 0
      text: it gives me a sense of peace.
    - speaker: 1
      text: hahaha
    - speaker: 1
      text: a sense of peace
    - speaker: 1
      text: something i could never feel in the city...
    - speaker: 1
      text: ...
    - speaker: 0
      text: ...
