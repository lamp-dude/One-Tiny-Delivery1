  - id: E-T
    objectiveName: the temple.
    giverVoice: 6
    cargoPrefab: {fileID: 1246973915080248, guid: ed784d07f629e48a191a3bab51dd3015, type: 3}
    safeCargoAnchor: {fileID: 1207837740943526512}
    cargoSpawnHeight: 1
    droppedDistance: 3
    destroyCargoOnDelivery: 1
    pickupConversation: []
    startedConversation: []
    startedReturnConversation:
    - speaker: 0
      text: the temple is just past the next climb.
    - speaker: 1
      text: got it, i'll keep your prayer safe!
    finishedConversation:
    - speaker: 0
      text: thanks for taking that journal up for me!
    - speaker: 1
      text: 'no problem! '
    - speaker: 1
      text: 'i wanted to get out of the city '
    - speaker: 1
      text: this was great
    acceptAfterNotStartedDialogue: 1
    arrivalConversation:
    - speaker: 0
      text: 'hello, traveler. '
    - speaker: 0
      text: taking a breather?
    - speaker: 1
      text: yea
    - speaker: 1
      text: a hiker wanted me to give you his prayer
    - speaker: 1
      text: he says to give a scroll to you
    - speaker: 1
      text: and the Doro god will keep him safe?
    deliveredConversation:
    - speaker: 0
      text: i see the scroll, is that it?
    - speaker: 1
      text: yep
    - speaker: 0
      text: alright, you are all set traveler
    - speaker: 0
      text: the Doro god will appreciate the good deed you have done today
    droppedCargoConversation:
    - speaker: 0
      text: i will take care of that
    - speaker: 0
      text: where is the scroll?
    - speaker: 1
      text: 'oh no... '
    - speaker: 1
      text: please don't tell me i lost THAT
    - speaker: 1
      text: oh no no no
    - speaker: 0
      text: traveler calm down
    - speaker: 0
      text: maybe the mountains want it instead
    - speaker: 0
      text: i hope they will be the carrier of the prayer to the Doro god.
    nextDeliveryConversation:
    - speaker: 0
      text: why are you climbing this mountain anyway?
    - speaker: 0
      text: surely you didn't just think you wanted to climb a mountain in that tiny
        truck?
    - speaker: 1
      text: 'well, you see... '
    - speaker: 1
      text: it's a long story
    - speaker: 1
      text: i just wanted to get out of the city
    - speaker: 1
      text: and just... chill a bit
    - speaker: 0
      text: hmm
    - speaker: 0
      text: chill a bit...
    - speaker: 0
      text: i see
    - speaker: 0
      text: well there is a house at the peak of this mountain
    - speaker: 0
      text: every year i send its keeper one apple from the valley
    - speaker: 1
      text: one apple? all the way up there?
    - speaker: 0
      text: 'just one. '
    - speaker: 0
      text: he likes to eat it while he watches the sunset
    - speaker: 0
      text: maybe this time you'd be the one delivering it?
    - speaker: 0
      text: it's one tiny delivery
    - speaker: 1
      text: you know what?
    - speaker: 1
      text: yes i will
    - speaker: 1
      text: i've come this far
    - speaker: 1
      text: i'll deliver this one apple
    - speaker: 1
      text: it's just one apple!
    - speaker: 0
      text: i'll even tape it down so i don't lose it
    - speaker: 0
      text: good, good!
    - speaker: 0
      text: 'may the Doro gods protect you. '
