  - id: J-L
    objectiveName: Statue Delivery
    giverVoice: 2
    cargoPrefab: {fileID: 1087910323514197239, guid: 07057acbe49496345866e485c63cb8dc, type: 3}
    safeCargoAnchor: {fileID: 1207837740943526512}
    cargoSpawnHeight: 1
    droppedDistance: 5
    destroyCargoOnDelivery: 1
    pickupConversation:
    - speaker: 0
      text: pickup conversation
    startedConversation:
    - speaker: 0
      text: started convo
    startedReturnConversation:
    - speaker: 0
      text: hey, can you tell me more about that lake?
    - speaker: 0
      text: sure!
    - speaker: 0
      text: i mean, its just a lake
    - speaker: 0
      text: 
    - speaker: 1
      text: just a lake?
    - speaker: 0
      text: well...
    - speaker: 0
      text: there were rumors
    - speaker: 0
      text: like the one i'm sure you've heard
    - speaker: 0
      text: where if you go to it at midnight
    - speaker: 0
      text: the ghosts of the couple that drowned there
    - speaker: 0
      text: '2 years ago '
    - speaker: 0
      text: would appear on the surface
    - speaker: 0
      text: but that was just a rumor
    - speaker: 0
      text: now about that statue...
    - speaker: 1
      text: 'yes, yes i''m on it '
    finishedConversation:
    - speaker: 0
      text: thank you so much for delivering it!
    - speaker: 1
      text: 'of course! '
    - speaker: 0
      text: have a nice day!
    acceptAfterNotStartedDialogue: 1
    arrivalConversation:
    - speaker: 0
      text: oh
    - speaker: 0
      text: hello
    - speaker: 0
      text: who are you?
    - speaker: 1
      text: i'm Bubo
    deliveredConversation:
    - speaker: 1
      text: Mrs. Johnston sent me to deliver this statue for your cat
    - speaker: 0
      text: oh yes...
    - speaker: 0
      text: the statue...
    - speaker: 0
      text: thanks.
    - speaker: 1
      text: of course Mr. Lawrence
    - speaker: 1
      text: i'm very sorry for your loss
    - speaker: 1
      text: i'm sure your cat would be happy if it saw the statue
    - speaker: 0
      text: '... it? IT? '
    - speaker: 1
      text: i'm so sorry i mea-
    - speaker: 0
      text: his name was Kiki.
    - speaker: 0
      text: 'and he was... '
    - speaker: 0
      text: he was so sweet...
    - speaker: 0
      text: what am i gonna do without him?
    - speaker: 0
      text: ...
    - speaker: 0
      text: forgive me young man
    - speaker: 0
      text: i just miss him so much
    - speaker: 1
      text: i understand Mr. Lawrence
    - speaker: 0
      text: thank you so much for delivering this to me
    - speaker: 0
      text: i appreciate you
    - speaker: 1
      text: 'not a problem! '
    - speaker: 1
      text: can i help you with anything?
    - speaker: 0
      text: 'you know... '
    - speaker: 0
      text: yes!
    droppedCargoConversation:
    - speaker: 1
      text: i was supposed to deliver a cat statue
    - speaker: 0
      text: 'oh yes! '
    - speaker: 0
      text: the statue!
    - speaker: 0
      text: do you have it?
    - speaker: 1
      text: well...
    - speaker: 1
      text: no
    - speaker: 0
      text: ...
    - speaker: 0
      text: what happened to it?
    - speaker: 1
      text: ...
    - speaker: 1
      text: 'im so sorry but i dropped it '
    - speaker: 1
      text: and it was too heavy to pick up
    - speaker: 0
      text: well...
    - speaker: 0
      text: that's a pity
    - speaker: 0
      text: i think
    - speaker: 0
      text: Kiki would have loved...
    - speaker: 0
      text: 'the statue... '
    - speaker: 1
      text: i'm so sorry for your loss
    - speaker: 0
      text: ah its fine kid
    - speaker: 0
      text: well since you came here empty handed
    nextDeliveryConversation:
    - speaker: 0
      text: can you...
    - speaker: 0
      text: drop soemthing off at the gas station?
    - speaker: 1
      text: what do you need dropped off?
    - speaker: 0
      text: these flowers
    - speaker: 1
      text: oh flowers?
    - speaker: 1
      text: sure i can do that
    - speaker: 0
      text: yes, i want these flowers to go to Anna
    - speaker: 0
      text: she works at the gas station that you passed when you came here
    - speaker: 0
      text: she was always so sweet to Kiki...
    - speaker: 0
      text: and...
    - speaker: 0
      text: she took care of me when Kiki passed
    - speaker: 0
      text: give her my thanks will you?
    - speaker: 1
      text: i will i will
    - speaker: 1
      text: i'll see you around alright?
    - speaker: 0
      text: yes, and thank you!
